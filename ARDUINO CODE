void connectWiFi()
{
  Serial.println();

  Serial.println(
    "Connecting to WiFi..."
  );


  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );

  int attempts = 0;

  while (
    WiFi.status() != WL_CONNECTED &&
    attempts < 30
  )
  {
    delay(500);

    Serial.print(".");

    attempts++;
  }

  Serial.println();


  if (
    WiFi.status() ==
    WL_CONNECTED
  )
  {
    Serial.println(
      "WiFi Connected!"
    );


    Serial.print(
      "IP Address: "
    );

    Serial.println(
      WiFi.localIP()
    );
  }

  else
  {
    Serial.println(
      "WiFi Connection Failed!"
    );
  }
}

void setup()
{
  
  Serial.begin(115200);
  GPS_Serial.begin(
    9600,
    SERIAL_8N1,
    GPS_RX_PIN,
    GPS_TX_PIN
  );

  pinMode(
    MEMS_PIN,
    INPUT
  );


  pinMode(
    FLOW_PIN,
    INPUT_PULLUP
  );


  pinMode(
    OBJECT_TRIG_PIN,
    OUTPUT
  );


  pinMode(
    OBJECT_ECHO_PIN,
    INPUT
  );


  pinMode(
    DEPTH_TRIG_PIN,
    OUTPUT
  );


  pinMode(
    DEPTH_ECHO_PIN,
    INPUT
  );

  pinMode(
    RED_LED,
    OUTPUT
  );


  pinMode(
    YELLOW_LED,
    OUTPUT
  );


  pinMode(
    GREEN_LED,
    OUTPUT
  );

  pinMode(
    MOTOR_A_I1,
    OUTPUT
  );


  pinMode(
    MOTOR_A_I2,
    OUTPUT
  );


  pinMode(
    MOTOR_B_I3,
    OUTPUT
  );

  pinMode(
    MOTOR_B_I4,
    OUTPUT
  );

------------------------------------------------------

  stopRobot();

  digitalWrite(
    RED_LED,
    LOW
  );

  digitalWrite(
    YELLOW_LED,
    LOW
  );

  digitalWrite(
    GREEN_LED,
    LOW
  );

  attachInterrupt(
    digitalPinToInterrupt(FLOW_PIN),
    flowPulseISR,
    RISING
  );

  connectWiFi();
--------------------------------------------------

  Serial.println();

  Serial.println(
    "=========================================="
  );

  Serial.println(
    " SMART RIVER MONITORING ROBOT STARTED"
  );

  Serial.println(
    "=========================================="
  );


  Serial.println(
    "Both motors will run FORWARD."
  );


  moveForward();


  Serial.println(
    "MOTOR A: FORWARD"
  );

  Serial.println(
    "MOTOR B: FORWARD"
  );


  lastFlowCalculation =
    millis();

  lastThingSpeakUpdate =
    millis();
}

void loop()
{
  
  readGPS();
  readMEMS();
  calculateFlow();
  objectDistance =
    readUltrasonic(
      OBJECT_TRIG_PIN,
      OBJECT_ECHO_PIN
    );
  readWaterDepth();

  detectWaterDisturbance();
  autonomousNavigation();
  updateTrafficLight();
  printSensorValues();
  if (
    millis() -
    lastThingSpeakUpdate
    >=
    THINGSPEAK_INTERVAL
  )
  {
    updateThingSpeak();

    lastThingSpeakUpdate =
      millis();
  }

  delay(1000);
}
